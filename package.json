{
  "name": "pyxis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/unit/*.test.ts",
    "test:emulator": "npx -y firebase-tools@15.33.0 emulators:exec --only firestore,storage --project demo-pyxis \"tsx --tsconfig tsconfig.app.json --test --test-concurrency=1 tests/rules/*.test.ts tests/emulator/*.test.ts\""
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.7.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.6.2",
    "react-simple-maps": "^3.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.10",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.7.0",
    "globals": "^17.4.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wrangler": "4.144.0"
  }
}
