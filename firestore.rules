rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && exists(memberPath(workspaceId, request.auth.uid));
    }

    // Doc del miembro que hace la request (Firestore cachea el get dentro de
    // una misma evaluación, así que llamarlo varias veces cuesta una lectura).
    function me(workspaceId) {
      return get(memberPath(workspaceId, request.auth.uid)).data;
    }

    function isOwner(workspaceId) {
      return isWorkspaceMember(workspaceId) && me(workspaceId).role == "owner";
    }

    function emailMatches(email) {
      return request.auth.token.email != null
             && request.auth.token.email.lower() == email.lower();
    }

    // Alcance de lectura por rol (clients, calls y sus documentos):
    // owner todo · supervisor su subequipo (si tiene uno) · cualquiera lo suyo.
    function canSee(workspaceId, data) {
      let m = me(workspaceId);
      let sub = m.get("subteam_id", null);
      return m.role == "owner"
             || data.owner_uid == request.auth.uid
             || (m.role == "supervisor" && sub != null && data.subteam_id == sub);
    }

    // A quién puede pertenecer un registro que este usuario crea o reasigna:
    // owner a cualquiera · uno mismo dentro de su subequipo · supervisor a
    // miembros de su subequipo.
    function canHold(workspaceId, data) {
      let m = me(workspaceId);
      let sub = m.get("subteam_id", null);
      return m.role == "owner"
             || (data.owner_uid == request.auth.uid && data.subteam_id == sub)
             || (m.role == "supervisor" && sub != null && data.subteam_id == sub
                 && get(memberPath(workspaceId, data.owner_uid)).data.get("subteam_id", null) == sub);
    }

    // Eventos del sistema del cliente (spec 03-R6): solo se agregan; nadie
    // edita ni borra los que ya existen.
    function activityAppendOnly() {
      let before = resource.data.get("activity", []);
      let after = request.resource.data.get("activity", []);
      return after.size() >= before.size() && after.hasAll(before);
    }

    function ownershipUnchanged() {
      return request.resource.data.owner_uid == resource.data.owner_uid
             && request.resource.data.get("subteam_id", null) == resource.data.get("subteam_id", null);
    }

    // ── Usuarios ──

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.workspace_id == null;
      // workspace_id solo puede apuntar a un workspace donde el usuario queda
      // como miembro al terminar la escritura (crear workspace o aceptar
      // invitación), o volver a null.
      allow update: if signedIn() && request.auth.uid == uid
                    && (request.resource.data.get("workspace_id", null) == resource.data.get("workspace_id", null)
                        || request.resource.data.get("workspace_id", null) == null
                        || existsAfter(memberPath(request.resource.data.workspace_id, uid)));
      // El owner puede desvincular a alguien que quitó de su workspace.
      allow update: if signedIn()
                    && resource.data.get("workspace_id", null) != null
                    && isOwner(resource.data.workspace_id)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["workspace_id"])
                    && request.resource.data.workspace_id == null
                    && !existsAfter(memberPath(resource.data.workspace_id, uid));
    }

    // Navegadores suscritos a los avisos de llamadas con Pyxis cerrado (spec 21
    // fase 2). Cada usuario gestiona solo los suyos; el Worker los lee y borra
    // los vencidos con su service account (sin pasar por estas reglas).
    match /users/{uid}/push_subscriptions/{subId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(
                                 ["endpoint", "p256dh", "auth", "timezone", "user_agent", "updated_at"])
                            && request.resource.data.endpoint is string
                            && request.resource.data.endpoint.matches("https://.+")
                            && request.resource.data.p256dh is string
                            && request.resource.data.auth is string;
    }

    // Admins globales (editan la referencia de estados). Solo se gestionan con
    // el Admin SDK: `npx tsx scripts/set-admin.ts`.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // ── Workspaces ──

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      // Los workspaces los crea un admin global con scripts/create-workspace.ts
      // (Admin SDK); desde la app nadie los crea (spec 22).
      allow create: if false;
      // Cambiar owner_uid solo como parte de un traspaso: el nuevo owner queda
      // con rol owner en el mismo batch (spec 06).
      allow update: if isOwner(workspaceId)
                    && (request.resource.data.owner_uid == resource.data.owner_uid
                        || getAfter(memberPath(workspaceId, request.resource.data.owner_uid)).data.role == "owner");
      allow delete: if isOwner(workspaceId);
    }

    match /workspaces/{workspaceId}/members/{uid} {
      allow read: if isWorkspaceMember(workspaceId)
                  || (signedIn() && request.auth.uid == uid);

      // Nadie se crea a sí mismo como miembro salvo al aceptar una invitación
      // válida en el mismo batch. El owner lo crea el script de alta (spec 22).
      allow create: if signedIn() && request.auth.uid == uid
                    && joinsViaInvitation(workspaceId);

      // Rol y subequipo solo los cambia el owner (nadie se los cambia a sí
      // mismo), salvo el owner que entrega la propiedad (spec 06).
      allow update: if isOwner(workspaceId) && request.auth.uid != uid;
      allow update: if isOwner(workspaceId) && request.auth.uid == uid
                    && (request.resource.data.role == resource.data.role
                        || handsOverOwnership(workspaceId));
      allow delete: if isOwner(workspaceId);
    }

    // El owner pasa a supervisor solo si, al terminar el batch, el workspace
    // tiene otro owner_uid y ese miembro quedó como owner.
    function handsOverOwnership(workspaceId) {
      let wsAfter = getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
      return request.resource.data.role == "supervisor"
             && wsAfter.owner_uid != request.auth.uid
             && getAfter(memberPath(workspaceId, wsAfter.owner_uid)).data.role == "owner";
    }

    function joinsViaInvitation(workspaceId) {
      let invPath = /databases/$(database)/documents/workspaces/$(workspaceId)/invitations/$(request.resource.data.invitation_id);
      let inv = get(invPath).data;
      let invAfter = getAfter(invPath).data;
      return inv.status == "pending"
             && inv.expires_at > request.time
             && emailMatches(inv.email)
             && request.resource.data.role == inv.role
             && request.resource.data.subteam_id == inv.subteam_id
             && invAfter.status == "accepted"
             && invAfter.accepted_by == request.auth.uid;
    }

    // ── Invitaciones ──
    // El doc ID es el token del link: conocerlo equivale a tener la invitación,
    // así que el invitado (que aún no es miembro) puede leerla por ID. Listar
    // queda solo para el owner.

    match /workspaces/{workspaceId}/invitations/{invId} {
      allow get: if signedIn();
      allow list: if isOwner(workspaceId);
      allow create: if isOwner(workspaceId) && request.resource.data.status == "pending";
      allow update: if isOwner(workspaceId);
      allow update: if signedIn()
                    && resource.data.status == "pending"
                    && resource.data.expires_at > request.time
                    && emailMatches(resource.data.email)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "accepted_by", "accepted_at"])
                    && request.resource.data.status == "accepted"
                    && request.resource.data.accepted_by == request.auth.uid
                    && existsAfter(memberPath(workspaceId, request.auth.uid));
      allow delete: if isOwner(workspaceId);
    }

    // ── Clientes ──

    match /workspaces/{workspaceId}/clients/{clientId} {
      allow read: if isWorkspaceMember(workspaceId) && canSee(workspaceId, resource.data);
      allow create: if isWorkspaceMember(workspaceId) && canHold(workspaceId, request.resource.data);
      // Reasignar (cambiar owner_uid/subteam_id) exige poder asignar al destino.
      allow update: if isWorkspaceMember(workspaceId)
                    && canSee(workspaceId, resource.data)
                    && (ownershipUnchanged() || canHold(workspaceId, request.resource.data))
                    && activityAppendOnly();
      // Borrar de verdad (datos personales, SSN) solo el owner; el resto
      // archiva (spec 06).
      allow delete: if isOwner(workspaceId);

      // Los documentos heredan el acceso de su cliente.
      match /documents/{docId} {
        function clientData() {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(clientId)).data;
        }

        allow read: if isWorkspaceMember(workspaceId) && canSee(workspaceId, clientData());
        allow create: if isWorkspaceMember(workspaceId)
                      && canSee(workspaceId, clientData())
                      && request.resource.data.uploaded_by_uid == request.auth.uid;
        allow delete: if isWorkspaceMember(workspaceId)
                      && canSee(workspaceId, clientData())
                      && (me(workspaceId).role == "owner"
                          || resource.data.uploaded_by_uid == request.auth.uid);
      }
    }

    // ── Índice de teléfonos (spec 07) ──
    // Doc ID = 10 dígitos; `client_ids` = clientes que usan ese número. Un
    // miembro lee un número por su ID para saber si ya es cliente (también de
    // otro agente), pero no puede listar los teléfonos del workspace. Cada
    // escritura cambia un solo cliente (`last_client_id`) y debe coincidir con
    // el `phone_digits` de ese cliente al terminar el batch.

    match /workspaces/{workspaceId}/phone_index/{digits} {
      function touched() {
        return /databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(request.resource.data.last_client_id);
      }
      function idsBefore() {
        return resource == null ? {} : resource.data.get("client_ids", {});
      }
      function addsClient() {
        return existsAfter(touched())
               && canSee(workspaceId, getAfter(touched()).data)
               && getAfter(touched()).data.get("phone_digits", []).hasAny([digits]);
      }
      // Sin el cliente al terminar el batch, solo el owner (borrar es suyo).
      function removesClient() {
        return existsAfter(touched())
               ? canSee(workspaceId, getAfter(touched()).data)
                 && !getAfter(touched()).data.get("phone_digits", []).hasAny([digits])
               : isOwner(workspaceId);
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list, delete: if isOwner(workspaceId);
      allow create, update: if isWorkspaceMember(workspaceId)
                            && request.resource.data.keys().hasOnly(["client_ids", "last_client_id"])
                            && request.resource.data.client_ids is map
                            && request.resource.data.last_client_id is string
                            && request.resource.data.client_ids.diff(idsBefore()).affectedKeys()
                                 .hasOnly([request.resource.data.last_client_id])
                            && (request.resource.data.last_client_id in request.resource.data.client_ids
                                ? addsClient()
                                : removesClient());
    }

    // ── Llamadas (mismo modelo que clientes) ──

    // Una llamada es a un cliente (client_id) o a un lead sin registrar
    // (client_id null + lead con nombre y teléfono), nunca a ninguno (spec 19).
    function validCallTarget(d) {
      return (d.get("client_id", null) is string && !("lead" in d))
             || (d.get("client_id", null) == null
                 && d.get("lead", null) is map
                 && d.lead.get("name", "") is string && d.lead.get("name", "").size() > 0
                 && d.lead.get("phone", "") is string && d.lead.get("phone", "").size() > 0);
    }

    match /workspaces/{workspaceId}/calls/{callId} {
      allow read: if isWorkspaceMember(workspaceId) && canSee(workspaceId, resource.data);
      allow create: if isWorkspaceMember(workspaceId)
                    && canHold(workspaceId, request.resource.data)
                    && validCallTarget(request.resource.data);
      allow update: if isWorkspaceMember(workspaceId)
                    && canSee(workspaceId, resource.data)
                    && (ownershipUnchanged() || canHold(workspaceId, request.resource.data))
                    && validCallTarget(request.resource.data);
      allow delete: if isWorkspaceMember(workspaceId)
                    && (me(workspaceId).role == "owner" || resource.data.owner_uid == request.auth.uid);
    }

    // ── Metas y subequipos ──

    match /workspaces/{workspaceId}/goals/{goalId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow write: if isWorkspaceMember(workspaceId)
                   && (me(workspaceId).role == "owner" || me(workspaceId).role == "supervisor");
    }

    match /workspaces/{workspaceId}/subteams/{subteamId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow write: if isOwner(workspaceId);
    }

    // ── Referencia global ──
    // `states` es global para toda la app: solo la editan admins globales, no
    // los owners de cada workspace (cualquiera puede crear un workspace).

    match /states/{doc} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /trades/{doc} { allow read: if signedIn(); }
    match /glossary/{doc} { allow read: if signedIn(); }
  }
}
